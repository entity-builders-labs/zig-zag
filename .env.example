# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zigzag
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zigzag
SUPABASE_PASSWORD=

# =================================
# DEVELOPMENT ENVIRONMENT
# =================================
NODE_ENV=development

# =================================
# API CONFIGURATION
# =================================
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_CORS_PROXY_URL=http://localhost:8080

# =================================
# GOOGLE MAPS API
# =================================
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# =================================
# AI CONFIGURATION
# =================================
GROQ_API_KEY=
OPENAI_API_KEY=
ENABLE_AI=true
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
EMBEDDINGS_MODEL=nomic-embed-text

# =================================
# OLLAMA CONFIGURATION
# =================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MEMORY_LIMIT=6G
OLLAMA_MEMORY_RESERVATION=3G
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=300000

# =================================
# CHROMA CONFIGURATION
# =================================
CHROMA_URL=http://chroma:8000
CHROMA_HOST=0.0.0.0
CHROMA_PORT=8000
PERSIST_DIRECTORY=/data

# =================================
# DEVELOPMENT SETTINGS
# =================================
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
FAST_REFRESH=true
EXPO_USE_FAST_REFRESH=true

# =================================
# PORT CONFIGURATION
# =================================
PORT=3000

# =================================
# DOCKER CONFIGURATION
# =================================
DOCKER_CONTAINER=true


// MCP token from github account 
MCP_GH_TOKEN=


# Google Maps Mocking
USE_MOCK_MAPS=true          # Enable mocking layer
MOCK_MAPS_MODE=read         # Modes: 'read' (use cache), 'write' (call API & save), 'strict' (error on miss)
ALLOW_API_FALLBACK=true     # If true, 'read' mode will call API on cache miss (like 'write' but without saving?) - Actually handled by logic

# AI Service Mocking
AI_CACHE_MODE=read          # Modes: 'read' (use cache), 'write' (call API & save), 'off' (disable cache)
STORAGE_PATH=