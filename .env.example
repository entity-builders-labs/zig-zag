# =================================
# DOCKER COMPOSE
# =================================
# Enables the local PostgreSQL container (required for backend in development).
# Remove this line if you use Supabase via DATABASE_URL instead.
COMPOSE_PROFILES=dev

# =================================
# APPLICATION
# =================================
NODE_ENV=development
PORT=3000
APP_NAME="ZigZag API"

# =================================
# SECURITY & CORS
# =================================
CORS_ENABLED=true
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# =================================
# DATABASE
# =================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zigzag
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zigzag
SUPABASE_PASSWORD=your_supabase_password

# =================================
# FRONTEND (EXPO)
# =================================
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_CORS_PROXY_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyA_dummy_key_example

# Web client id from Google Cloud Console — required by GoogleSignin.configure()
# so a Google Sign-In on any platform returns an idToken audienced for our
# backend to verify (must be one of GOOGLE_CLIENT_IDS on the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Dev tools
WDS_SOCKET_PORT=4001
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100

# =================================
# GOOGLE MAPS
# =================================
GOOGLE_MAPS_API_KEY=AIzaSyA_dummy_key_example
# Mocks
USE_MOCK_MAPS=true
MOCK_MAPS_MODE=read
ALLOW_API_FALLBACK=true

# =================================
# GEOAPIFY (free alternative to Google Places — optional)
# =================================
# Get a free key at https://www.geoapify.com/ (3,000 requests/day free tier)
GEOAPIFY_API_KEY=your_geoapify_key_here
# Which provider crawlAndSaveActivities() uses: google | geoapify
PLACES_PROVIDER=google

# =================================
# AI CONFIGURATION
# =================================
ENABLE_AI=true
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
EMBEDDINGS_MODEL=nomic-embed-text
AI_CACHE_MODE=read
STORAGE_PATH=/tmp/ai_cache

# Providers
GROQ_API_KEY=gsk_dummy_groq_key
OPENAI_API_KEY=sk-proj-dummy_openai_key
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000

# =================================
# OLLAMA CONFIGURATION
# =================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama_api_key_if_needed
OLLAMA_MEMORY_LIMIT=6G
OLLAMA_MEMORY_RESERVATION=3G
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=300000
OLLAMA_CPU_ONLY=false

# =================================
# CHROMA DB
# =================================
CHROMA_URL=http://chroma:8000
CHROMA_HOST=0.0.0.0
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=zigzag
CHROMA_COLLECTION_NAME=activities
CHROMA_API_KEY=chroma_auth_key
PERSIST_DIRECTORY=/data

# =================================
# AUTH (Google / Apple / Email OTP)
# =================================
# JWT signing secrets. Required in production; a dev-only default is used otherwise.
JWT_ACCESS_SECRET=dev-insecure-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-insecure-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Accepted audiences for ID token verification, comma-separated
# (Google issues a different client id per platform: web/iOS/Android).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Email OTP (passwordless login by code)
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP used to send the login code
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zig-Zag <no-reply@zigzag.app>

# =================================
# DEVELOPMENT SETTINGS
# =================================
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
FAST_REFRESH=true
EXPO_USE_FAST_REFRESH=true
DOCKER_CONTAINER=true

# =================================
# MISC
# =================================
MCP_GH_TOKEN=ghp_dummy_token