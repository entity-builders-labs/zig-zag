# =================================
# DOCKER COMPOSE
# =================================
# Enables the local PostgreSQL container (required for backend in development).
# Remove this line if you use Supabase via DATABASE_URL instead.
COMPOSE_PROFILES=dev

# =================================
# APPLICATION
# =================================
NODE_ENV=development
PORT=3000
APP_NAME="ZigZag API"

# =================================
# SECURITY & CORS
# =================================
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# =================================
# DATABASE
# =================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zigzag
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zigzag

# =================================
# FRONTEND (EXPO)
# =================================
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_CORS_PROXY_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyA_dummy_key_example

# Web client id from Google Cloud Console — required by GoogleSignin.configure()
# so a Google Sign-In on any platform returns an idToken audienced for our
# backend to verify (must be one of GOOGLE_CLIENT_IDS on the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Web Push uses the same public VAPID key in the PWA and private key only in backend.
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Dev tools
WDS_SOCKET_PORT=4001
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.100

# =================================
# GOOGLE MAPS
# =================================
GOOGLE_MAPS_API_KEY=AIzaSyA_dummy_key_example
# Provider-response cache. `read` uses cache first and calls the selected live
# provider on a miss; `write` also stores the live response; `strict` never
# performs a live call.
USE_MOCK_MAPS=true
MOCK_MAPS_MODE=read
ALLOW_API_FALLBACK=true

# =================================
# PLACES PROVIDERS
# =================================
GEOAPIFY_API_KEY=your_geoapify_key_here
# Backend catalog refill provider: google | geoapify. Google is the MVP
# default; unknown values fail backend startup.
PLACES_PROVIDER=google

# Frontend-visible key for fe/features/map/directions.ts (Geoapify allows
# direct browser calls — no cors-proxy needed, unlike Google Directions).
# Can be the same key as GEOAPIFY_API_KEY above, restricted by HTTP referrer
# in the Geoapify console instead of by IP.
EXPO_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_key_here
# Which provider fetchWalkingRoute() uses for the on-map walking route: google | geoapify
EXPO_PUBLIC_DIRECTIONS_PROVIDER=geoapify
# Which provider destination/address autocomplete uses: google | geoapify
# This frontend choice is independent from backend catalog refill.
EXPO_PUBLIC_PLACES_PROVIDER=geoapify

# =================================
# OPENSTREETMAP / OVERPASS (composite activities — streets, boundaries)
# =================================
# Public instance, free, no API key — but shared and rate-limited. Reuses
# USE_MOCK_MAPS/MOCK_MAPS_MODE above so tests/CI never hit it unintentionally.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Must exceed the heaviest query's own server-side `[timeout:30]` tag
# (overpass-query.util.ts) with real margin — a shorter client timeout aborts
# requests the (slow, shared, public) Overpass server would have finished
# successfully, silently dropping real, correctly-tagged OSM data.
OVERPASS_TIMEOUT_MS=40000
# Retry only the transient statuses 429/502/503/504. Retries stay on the same
# provider and must fit inside the total per-query time budget.
OVERPASS_MAX_RETRIES=2
OVERPASS_RETRY_BASE_MS=500
OVERPASS_TOTAL_BUDGET_MS=90000
# Cap for queryStreets — deliberately independent of any tour-wide search
# radius (a neighborhood_walk is walkable by definition).
OVERPASS_MAX_RADIUS_METERS=2500
# Max concurrent requests to the shared public instance app-wide.
OVERPASS_MAX_CONCURRENCY=2

# Nominatim resolves destination names and selected coordinates. Production
# should point these URLs to a self-hosted or managed service; the public
# community endpoint is for bounded development/spike use, not mass traffic.
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_API_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_TIMEOUT_MS=10000

# =================================
# WIKIDATA (composite activities — narrative context, dev-only in V1)
# =================================
# Public API, free, no key. Reuses USE_MOCK_MAPS/MOCK_MAPS_MODE above.
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php

# =================================
# AI CONFIGURATION
# =================================
ENABLE_AI=true
AI_PROVIDER=groq
AI_MODEL=llama-3.1-8b-instant
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama
# AWS production uses Bedrock Titan instead of OpenAI/Ollama:
# EMBEDDING_PROVIDER=bedrock
# EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDING_DIMENSIONS=256
# AWS_REGION=us-east-1
AI_CACHE_MODE=read
STORAGE_PATH=/tmp/ai_cache

# Providers
GROQ_API_KEY=gsk_dummy_groq_key
# Grounded search evidence provider: groq | serpapi | tavily
# Defaults to groq when no explicit provider is set and no SerpApi key exists.
GROUNDED_SEARCH_PROVIDER=groq
# SerpApi (serpapi.com) — real web search evidence for grounded Activity Discovery,
# decoupled from the LLM's own token quota. Optional.
SERPAPI_API_KEY=
# Tavily — plain web search evidence for grounded Activity Discovery. The
# extractor remains independently configured below.
TAVILY_API_KEY=
# Discovery extraction (ActivityProposal extraction from grounded evidence) —
# separate from AI_PROVIDER above, which drives itinerary/composite generation.
# Config-driven so it can swap without a redeploy: Gemini is the default (keeps
# Groq's shared 8000 TPM free-tier budget free for itinerary generation alone).
DISCOVERY_EXTRACTOR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DISCOVERY_MODEL=gemini-3.5-flash-lite
GROQ_DISCOVERY_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=sk-proj-dummy_openai_key
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60000

# =================================
# OLLAMA CONFIGURATION
# =================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama_api_key_if_needed
OLLAMA_MEMORY_LIMIT=6G
OLLAMA_MEMORY_RESERVATION=3G
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=300000
OLLAMA_CPU_ONLY=false

# =================================
# AUTH (Google / Apple / Email OTP)
# =================================
# JWT signing secrets. Required in production; a dev-only default is used otherwise.
JWT_ACCESS_SECRET=dev-insecure-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-insecure-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Accepted audiences for ID token verification, comma-separated
# (Google issues a different client id per platform: web/iOS/Android).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Email OTP (passwordless login by code)
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP used to send the login code
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Zig-Zag <no-reply@zigzag.app>

# Web Push / PWA. Generate once with `npx web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@zigzag.app

# =================================
# DEVELOPMENT SETTINGS
# =================================
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000
FAST_REFRESH=true
EXPO_USE_FAST_REFRESH=true
DOCKER_CONTAINER=true

# =================================
# MISC
# =================================
MCP_GH_TOKEN=ghp_dummy_token
