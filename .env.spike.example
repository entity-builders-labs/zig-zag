# =================================================================
# PRE-B6 REAL-WORLD TOURISM RESEARCH SPIKE — override template
# =================================================================
# See docs/superpowers/plans/2026-09-12-real-world-tourism-research-spike-gate.md
# (§1, §5-13) for the full rationale. This file is a TEMPLATE — copy it to a
# real, git-ignored `.env.spike` and fill in nothing (it deliberately carries
# no secrets of its own): API keys still come from the repo-root `.env`,
# which `ConfigModule` always loads too (see below).
#
#   cp .env.spike.example .env.spike
#
# Then, from the repo root, export it into your shell BEFORE starting the
# backend so these values win over the shared `.env` without ever editing
# that shared file (`ConfigModule`'s dotenv loader never overrides a
# variable already present in `process.env` — see
# `be/src/core/config/config.module.ts` and `@nestjs/config`'s own
# `assignVariablesToProcess`, which filters to `!(key in process.env)`):
#
#   set -a; source .env.spike; set +a
#   cd be && yarn start:dev
#
# This is intentionally NOT wired into `docker-compose.yml`'s `backend`
# service defaults — those stay whatever the shared `.env` says (per the
# gate's own rule: "do not change production/dev defaults merely to make
# the spike pass"). Running the spike backend as a plain `yarn start:dev`
# process (outside the `backend` container) with this env sourced is the
# simplest way to keep the two fully separate; if you DO want it inside
# Compose, pass every one of these as literal `-e` overrides on the command
# line instead of editing docker-compose.yml's `environment:` block.

# ---------------------------------------------------------------
# 1. Grounded web discovery — force SerpAPI, forbid silent Tavily fallback
# ---------------------------------------------------------------
# The DI factory in `be/src/modules/tours/tours.module.ts`
# (EXPERIENCE_GROUNDED_SEARCH_PROVIDER) and `be/src/shared/ai/ai.config.ts`
# both resolve this value directly from `GROUNDED_SEARCH_PROVIDER` with NO
# fallback branch to `tavily` anywhere in that logic (the only fallback is
# `serpapi` when a key is present, else `groq`) -- explicitly pinning it
# here removes any ambiguity and makes the selection self-documenting in
# every spike manifest.
GROUNDED_SEARCH_PROVIDER=serpapi
# Do not set TAVILY_API_KEY here. Leaving it exactly as the shared `.env`
# already has it (present, for the normal dev stack) is fine -- the DI
# factory never reads it as a fallback trigger; only an explicit
# GROUNDED_SEARCH_PROVIDER=tavily would select it, which this file
# overrides. Also do not set GROUNDED_SEARCH_PROVIDER=gemini for this
# corpus: GeminiGroundedSearchService internally calls TavilyExtractService
# to fetch page content for cited URLs (see gemini-grounded-search.service.ts)
# -- a non-obvious SECOND way Tavily quota can be spent that has nothing to
# do with the primary GROUNDED_SEARCH_PROVIDER switch.

# ---------------------------------------------------------------
# 2/3/4/5. Local OSM topology (same Argentina Geofabrik source)
# ---------------------------------------------------------------
# Requires `docker compose --profile osm-local up -d` first (overpass +
# nominatim) -- see docs/development/local-overpass.md and
# docs/development/local-nominatim.md. Values below assume you run the
# spike backend on the host (yarn start:dev), reaching the containers via
# their published host ports; use the Compose service names instead
# (http://overpass/api/interpreter, http://nominatim:8080/...) if the spike
# backend itself runs inside the Compose network.
OVERPASS_API_URL=http://localhost:12345/api/interpreter
NOMINATIM_API_URL=http://localhost:8088/search
NOMINATIM_REVERSE_API_URL=http://localhost:8088/reverse

# ---------------------------------------------------------------
# 6. Clean-slate spike database
# ---------------------------------------------------------------
# A dedicated database on the SAME local Postgres/PostGIS server used by
# normal dev (docker-compose.yml's `postgres` service) -- not a separate
# server/container. Postgres's own database-level isolation (separate
# schemas/tables, zero shared rows) is sufficient for "dedicated real
# PostgreSQL/PostGIS database"; see the spike plan's clean-slate proof for
# how this was verified empty before RW1.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zigzag_spike_preb6
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zigzag_spike_preb6

# ---------------------------------------------------------------
# Mocks / caches — must be OFF for a genuine cold baseline
# ---------------------------------------------------------------
USE_MOCK_MAPS=false
MOCK_MAPS_MODE=strict
# (ALLOW_API_FALLBACK is not currently read anywhere in `be/src` -- a
# leftover from an earlier domain; not set here to avoid implying it does
# something it doesn't.)
# `off`, not `read`/`write` -- `read` would silently serve a stale cached
# LLM response for the exact same prompt+options hash if this destination/
# theme combination was ever exercised during earlier development (real
# risk: the shared dev `.env` normally runs AI_CACHE_MODE=read). `off`
# guarantees AiCacheService.getCachedResponse() always returns null and
# cacheResponse() always no-ops (see be/src/shared/ai/services/ai-cache.service.ts)
# -- every LLM call is genuinely live, every run.
AI_CACHE_MODE=off

# ---------------------------------------------------------------
# Places provider (used only where fallback/grounding needs it)
# ---------------------------------------------------------------
PLACES_PROVIDER=google

# ---------------------------------------------------------------
# Record in every spike manifest (not exhaustive -- see the plan's
# "Required run manifest" section for the full list, including
# DISCOVERY_EXTRACTOR_PROVIDER/model id and classification provider/model id,
# which are read from the shared `.env` unchanged by this file):
# ---------------------------------------------------------------
# branch, commit SHA, timestamp
# GROUNDED_SEARCH_PROVIDER (this file: serpapi)
# OVERPASS_API_URL / NOMINATIM_API_URL / NOMINATIM_REVERSE_API_URL (this file: local)
# DATABASE_URL target class (this file: zigzag_spike_preb6, redact credentials)
# AI_CACHE_MODE (this file: off)
# USE_MOCK_MAPS / MOCK_MAPS_MODE (this file: disabled)
