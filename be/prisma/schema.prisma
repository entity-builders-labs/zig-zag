generator client {
  provider    = "prisma-client-js"
  seedCommand = "npm run seed"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Activity {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  difficulty   Difficulty @default(EASY)
  type         String
  duration     Float
  price        Float
  maxGroupSize Int
  // Geolocation fields
  latitude     Float
  longitude    Float
  location     Json
  // Source relationship
  sourceId     String     @db.ObjectId
  source       Source     @relation(fields: [sourceId], references: [id])
  externalId   String

  // Google Places additional fields
  rating           Float?
  ratingCount      Int?
  formattedAddress String?
  phoneNumber      String?
  website          String?
  businessStatus   String?
  priceLevel       Int?
  photos           Json?
  openingHours     Json?
  metadata         Json?

  // Timestamps
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  knownActivityTypeName String?
  KnownActivityType     KnownActivityType? @relation(fields: [knownActivityTypeName], references: [name])
  TourActivity          TourActivity[]

  sourceRelations ActivityRelationship[] @relation("SourceActivities")
  targetRelations ActivityRelationship[] @relation("TargetActivities")

  @@unique([sourceId, externalId])
  @@map("activity")
}

model KnownActivityType {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  description String?
  icon        String?
  category    String?
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("known_activity_types")
}

model Tour {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  price        Float
  duration     Float
  maxGroupSize Int
  startDates   DateTime[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activities TourActivity[]

  @@map("tour")
}

model TourActivity {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tourId     String    @db.ObjectId
  activityId String    @db.ObjectId
  startTime  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Int       @default(1)
  tour       Tour      @relation(fields: [tourId], references: [id])
  activity   Activity  @relation(fields: [activityId], references: [id])

  @@index([tourId])
  @@index([activityId])
  @@map("tour_activity")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CrawlerSearch {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  latitude    Float
  longitude   Float
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([latitude, longitude])
  @@map("crawler_search")
}

model Source {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String     @unique
  type       String
  baseUrl    String?
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("source")
}

enum RelationType {
  SEQUENTIAL
  SIMILAR
  COMPLEMENTARY
}

model ActivityRelationship {
  id                     String       @id @default(auto()) @map("_id") @db.ObjectId
  sourceActivityId       String       @db.ObjectId
  targetActivityId       String       @db.ObjectId
  relationType           RelationType
  compatibilityScore     Int
  timeCompatibilityScore Int
  distanceScore          Int
  varietyScore           Int
  timeGapRecommended     Int?
  reasoning              String?
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  sourceActivity         Activity     @relation("SourceActivities", fields: [sourceActivityId], references: [id])
  targetActivity         Activity     @relation("TargetActivities", fields: [targetActivityId], references: [id])

  @@index([sourceActivityId])
  @@index([targetActivityId])
  @@index([compatibilityScore, timeCompatibilityScore, distanceScore, varietyScore])
  @@map("activity_relationship")
}
