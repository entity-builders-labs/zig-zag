generator client {
  provider        = "prisma-client-js"
  seedCommand     = "npm run seed"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// V2 physical geography primitive. This is deliberately independent from
// Experience identity: a provider identity belongs to a GeoEntity, while an
// Experience describes what a traveller can do with one or more entities.
model GeoEntity {
  id         String                @id @default(uuid())
  name       String
  kind       GeoEntityKind
  latitude   Float?
  longitude  Float?
  geometry   Json?
  address    String?
  metadata   Json?
  identities GeoEntityIdentity[]
  components ExperienceComponent[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([kind])
  @@index([latitude, longitude])
  @@map("geo_entity")
}

model GeoEntityIdentity {
  id          String    @id @default(uuid())
  geoEntityId String
  provider    String
  externalId  String
  geoEntity   GeoEntity @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, externalId])
  @@index([geoEntityId])
  @@map("geo_entity_identity")
}

model Experience {
  id                       String                      @id @default(uuid())
  canonicalName            String
  description              String?
  durationMinutes          Int?
  price                    Float?
  status                   ExperienceStatus            @default(PENDING)
  qualityScore             Float?
  latitude                 Float?
  longitude                Float?
  metadata                 Json?
  components               ExperienceComponent[]
  evidence                 ExperienceEvidence[]
  traits                   ExperienceTrait[]
  media                    ExperienceMedia[]
  tourExperiences          TourExperience[]
  mediaStatus              MediaStatus                 @default(PENDING)
  mediaUpdatedAt           DateTime?
  mediaError               String?
  embedding                Unsupported("vector(256)")?
  embeddingProvider        String?
  embeddingModel           String?
  embeddingDimensions      Int?
  embeddingDocumentVersion Int?
  embeddedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([status])
  @@index([latitude, longitude])
  @@index([embeddingProvider, embeddingModel, embeddingDimensions, embeddingDocumentVersion])
  @@map("experience")
}

model ExperienceComponent {
  id           String     @id @default(uuid())
  experienceId String
  geoEntityId  String
  order        Int?
  role         String?
  required     Boolean    @default(true)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  geoEntity    GeoEntity  @relation(fields: [geoEntityId], references: [id], onDelete: Restrict)

  @@unique([experienceId, geoEntityId])
  @@index([geoEntityId])
  @@map("experience_component")
}

model ExperienceEvidence {
  id           String     @id @default(uuid())
  experienceId String
  source       String
  url          String?
  title        String?
  snippet      String?
  discoveredAt DateTime   @default(now())
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("experience_evidence")
}

model ExperienceMedia {
  id           String     @id @default(uuid())
  experienceId String
  provider     String
  url          String
  width        Int?
  height       Int?
  caption      String?
  author       String?
  authorUrl    String?
  license      String?
  licenseUrl   String?
  sourceUrl    String?
  position     Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([experienceId, url])
  @@index([experienceId, position])
  @@index([provider])
  @@map("experience_media")
}

model TraitDefinition {
  id          String            @id @default(uuid())
  dimension   String
  key         String
  label       String?
  experiences ExperienceTrait[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([dimension, key])
  @@map("trait_definition")
}

model ExperienceTrait {
  experienceId      String
  traitDefinitionId String
  experience        Experience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  traitDefinition   TraitDefinition @relation(fields: [traitDefinitionId], references: [id], onDelete: Restrict)

  @@id([experienceId, traitDefinitionId])
  @@index([traitDefinitionId])
  @@map("experience_trait")
}

enum GeoEntityKind {
  PLACE
  AREA
  ROUTE
}

enum ExperienceStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

// Small fixed vocabulary on purpose — not free text, so variant identity
// The conceptual container behind a set of themed variants for one area
// (e.g. "San Telmo Walk" behind "San Telmo Historic Walk", "San Telmo Art
// Walk", ...) — never shown to the user directly. @@unique([areaActivityId,
// kind]) keeps repeated generate-templates runs (or concurrent live
// generations) from creating duplicate families for the same area.
//
// onDelete is asymmetric on purpose: compositeActivity is Cascade (deleting
// the whole variant cleans up its own waypoints), but waypointActivity is
// Restrict — deleting a POI that is still a waypoint of some variant fails
// instead of silently breaking that variant. See
// CompositeActivityService.mergeWaypointIdentity /
// removeWaypointFromActiveVariants for the explicit path required to
// operate on a referenced POI.
// A snapshot of which waypoints of a variant were actually used for one
model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String?
  avatarUrl        String?
  provider         AuthProvider
  providerId       String
  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours                Tour[]
  devices              UserDevice[]
  webPushSubscriptions WebPushSubscription[]

  @@unique([provider, providerId])
  @@map("user")
}

enum AuthProvider {
  GOOGLE
  APPLE
  EMAIL
}

model EmailLoginCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_login_code")
}

model Tour {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Nullable rather than required: tours created before auth existed (and
  // any generated without a logged-in user) have no owner. New tours always
  // get one — enforced by the auth guard on tour creation, not the schema.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Core fields - all optional for flexibility
  price        Float?
  duration     Float? // Duration in hours/days
  maxGroupSize Int?
  startDates   DateTime[] @default([]) // Empty array allowed - PostgreSQL supports arrays

  // Additional flexible fields
  totalDays            Int? // Total days of the tour
  totalDistance        Float? // Total distance in km
  estimatedBudget      Float? // Estimated budget
  recommendedGroupSize Int?

  // Visual content
  coverImage String? // URL to cover image

  // Store prompt/query that generated this tour
  prompt String? // The original prompt used
  query  String? // Search query if applicable

  // Categories - array of category names (e.g., "walking", "history", "food")
  categories String[] @default([])

  // Flexible metadata
  metadata Json? // Store any additional data from AI

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences TourExperience[]

  @@index([categories]) // Index for category filtering
  @@index([ownerId])
  @@map("tour")
}

// V2 tour snapshot. The shared Experience may be enriched later; this row and
// its component snapshots preserve what the traveller was actually given.
model TourExperience {
  id           String                    @id @default(uuid())
  tourId       String
  experienceId String
  dayNumber    Int?
  order        Int                       @default(1)
  startTime    DateTime?
  duration     Float?
  notes        String?
  tour         Tour                      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  experience   Experience                @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  components   TourExperienceComponent[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([tourId, experienceId, dayNumber, order])
  @@index([tourId])
  @@index([experienceId])
  @@map("tour_experience")
}

model TourExperienceComponent {
  id               String         @id @default(uuid())
  tourExperienceId String
  geoEntityId      String
  order            Int?
  role             String?
  required         Boolean        @default(true)
  name             String
  latitude         Float?
  longitude        Float?
  geometry         Json?
  tourExperience   TourExperience @relation(fields: [tourExperienceId], references: [id], onDelete: Cascade)

  @@index([tourExperienceId])
  @@map("tour_experience_component")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CrawlerSearch {
  id          String   @id @default(uuid())
  latitude    Float
  longitude   Float
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([latitude, longitude])
  @@map("crawler_search")
}

model Source {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   @default("external") // "external", "ai", "manual"
  baseUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("source")
}

enum MediaStatus {
  PENDING
  ENRICHED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  maxAttempts   Int          @default(5)
  nextAttemptAt DateTime?
  lastError     String?
  claimedAt     DateTime?
  leaseUntil    DateTime?
  publishedAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseUntil])
  @@index([status, publishedAt])
  @@index([status, failedAt])
  @@map("outbox_event")
}

model NegativeMediaLookup {
  id             String   @id @default(uuid())
  provider       String
  lookupStrategy String
  lookupKey      String
  negativeUntil  DateTime
  createdAt      DateTime @default(now())

  @@unique([provider, lookupStrategy, lookupKey])
  @@index([provider, lookupStrategy, lookupKey, negativeUntil])
  @@map("negative_media_lookup")
}

model UserDevice {
  id            String   @id @default(uuid())
  userId        String
  expoPushToken String   @unique
  platform      String // "ios" | "android" | "web"
  enabled       Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("user_device")
}

model WebPushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("web_push_subscription")
}
