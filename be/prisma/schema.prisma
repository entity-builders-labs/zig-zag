generator client {
  provider    = "prisma-client-js"
  seedCommand = "npm run seed"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Activity {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Core fields - all optional for flexibility
  type         String?
  difficulty   Difficulty?
  duration     Float?
  price        Float?
  maxGroupSize Int?

  // Geolocation - optional but recommended
  latitude  Float?
  longitude Float?
  location  Json? // Flexible location data
  address   String? // Simple address string

  // Source relationship - optional (AI-generated might not have source)
  sourceId   String?
  source     Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  externalId String? // Optional for AI-generated activities

  // Google Places additional fields
  rating           Float?
  ratingCount      Int?
  formattedAddress String?
  phoneNumber      String?
  website          String?
  businessStatus   String?
  priceLevel       Int?
  photos           Json?
  openingHours     Json?

  // Flexible metadata - store anything from AI prompts
  metadata Json? // Store AI-generated data, tags, recommendations, etc.

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional relationships
  knownActivityTypeName String?
  KnownActivityType     KnownActivityType? @relation(fields: [knownActivityTypeName], references: [name], onDelete: SetNull)
  TourActivity          TourActivity[]

  sourceRelations ActivityRelationship[] @relation("SourceActivities")
  targetRelations ActivityRelationship[] @relation("TargetActivities")

  @@unique([sourceId, externalId])
  @@index([latitude, longitude]) // For location queries
  @@index([sourceId])
  @@map("activity")
}

model KnownActivityType {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  icon        String?
  category    String?
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("known_activity_types")
}

model Tour {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Core fields - all optional for flexibility
  price        Float?
  duration     Float? // Duration in hours/days
  maxGroupSize Int?
  startDates   DateTime[] @default([]) // Empty array allowed - PostgreSQL supports arrays

  // Additional flexible fields
  totalDays            Int? // Total days of the tour
  totalDistance        Float? // Total distance in km
  estimatedBudget      Float? // Estimated budget
  recommendedGroupSize Int?

  // Store prompt/query that generated this tour
  prompt String? // The original prompt used
  query  String? // Search query if applicable

  // Flexible metadata
  metadata Json? // Store any additional data from AI

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities TourActivity[]

  @@map("tour")
}

model TourActivity {
  id               String    @id @default(uuid())
  tourId           String
  activityId       String? // Optional - might be creating activity inline
  startTime        DateTime?
  duration         Float? // Duration for this activity in the tour context
  notes            String? // Detailed notes from AI
  dayNumber        Int? // Which day of the tour
  travelTimeToNext Float? // Travel time to next activity
  distanceToNext   Float? // Distance to next activity
  order            Int       @default(1)

  // Inline activity data - for when activity doesn't exist yet
  activityName      String?
  activityType      String?
  activityLatitude  Float?
  activityLongitude Float?
  activityData      Json? // Store full activity data if creating inline

  tour     Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tourId])
  @@index([activityId])
  @@map("tour_activity")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CrawlerSearch {
  id          String   @id @default(uuid())
  latitude    Float
  longitude   Float
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([latitude, longitude])
  @@map("crawler_search")
}

model Source {
  id         String     @id @default(uuid())
  name       String     @unique
  type       String     @default("external") // "external", "ai", "manual"
  baseUrl    String?
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("source")
}

enum RelationType {
  SEQUENTIAL
  SIMILAR
  COMPLEMENTARY
}

model ActivityRelationship {
  id                     String       @id @default(uuid())
  sourceActivityId       String
  targetActivityId       String
  relationType           RelationType
  compatibilityScore     Int
  timeCompatibilityScore Int
  distanceScore          Int
  varietyScore           Int
  timeGapRecommended     Int?
  reasoning              String?
  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  sourceActivity         Activity     @relation("SourceActivities", fields: [sourceActivityId], references: [id], onDelete: Cascade)
  targetActivity         Activity     @relation("TargetActivities", fields: [targetActivityId], references: [id], onDelete: Cascade)

  @@index([sourceActivityId])
  @@index([targetActivityId])
  @@index([compatibilityScore, timeCompatibilityScore, distanceScore, varietyScore])
  @@map("activity_relationship")
}
