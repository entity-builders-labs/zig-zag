generator client {
  provider        = "prisma-client-js"
  seedCommand     = "npm run seed"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, postgis]
}

// V2 physical geography primitive. This is deliberately independent from
// Experience identity: a provider identity belongs to a GeoEntity, while an
// Experience describes what a traveller can do with one or more entities.
model GeoEntity {
  id                      String                           @id @default(uuid())
  name                    String
  kind                    GeoEntityKind
  latitude                Float?
  longitude               Float?
  geometry                Json?
  address                 String?
  metadata                Json?
  /// Verified hint memory (NOT an alias engine): the exact component-hint
  /// texts that previously resolved VERIFIED to THIS GeoEntity through
  /// external acquisition, stored verbatim. Never inferred from string
  /// similarity, never globally unique (the same text may be remembered on
  /// several GeoEntities; lookups keep that multiplicity). `name` stays the
  /// canonical, provider-backed display name.
  ///
  /// This pair is the FAST LOOKUP INDEX only. Provenance (who asserted the
  /// hint, when, and whether it was revoked) lives in
  /// `GeoEntityVerifiedHintAssertion`; a key stays here only while at least
  /// one active assertion supports it.
  verifiedHintNames       String[]                         @default([])
  /// `normalizeGeoName(verifiedHintNames[i])` -- positionally aligned with
  /// `verifiedHintNames` (a DB CHECK enforces equal cardinality) and
  /// deduplicated by key. The GIN index serves the `@>` lookup in
  /// `ExperienceCatalogService.findGeoEntityCandidatesForHint`.
  verifiedHintNameKeys    String[]                         @default([])
  identities              GeoEntityIdentity[]
  components              ExperienceComponent[]
  verifiedHintAssertions  GeoEntityVerifiedHintAssertion[]
  targetObservations      GeoEntityTargetObservation[]
  admission               GeoEntityAdmission?
  openingHours            GeoEntityOpeningHours?
  visitDuration           GeoEntityVisitDuration?
  prominenceEvidence      GeoEntityProminenceEvidence[]
  childRelations          GeoEntityRelation[]              @relation("RelationChild")
  parentRelations         GeoEntityRelation[]              @relation("RelationParent")
  traversalFromComponents ExperienceComponent[]            @relation("TraversalFrom")
  traversalToComponents   ExperienceComponent[]            @relation("TraversalTo")
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt

  @@index([kind])
  @@index([latitude, longitude])
  @@index([verifiedHintNameKeys], type: Gin)
  @@map("geo_entity")
}

model GeoEntityIdentity {
  id                String            @id @default(uuid())
  geoEntityId       String
  provider          String
  externalId        String
  /// Merge decision of this identity attachment (null on legacy rows).
  linkRule          IdentityLinkRule?
  linkPolicyVersion String?
  linkEvidence      Json?
  geoEntity         GeoEntity         @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([provider, externalId])
  @@index([geoEntityId])
  @@map("geo_entity_identity")
}

/// Provenance of one verified-hint assertion: "hint text H identifies
/// GeoEntity G", asserted by the automatic resolver or by an administrator.
/// Rows are never deleted: revocation stamps `revokedAt`, so the history of
/// a corrected (false) assertion survives. `GeoEntity.verifiedHintNames` /
/// `verifiedHintNameKeys` stay the fast lookup index and hold a key only
/// while an active (unrevoked) assertion supports it.
///
/// A partial unique index (migration SQL; Prisma cannot declare it) allows
/// at most ONE active assertion per (geoEntityId, hintKey, source).
model GeoEntityVerifiedHintAssertion {
  id               String                 @id @default(uuid())
  geoEntityId      String
  /// Verbatim hint text as it was asserted.
  hintName         String
  /// `normalizeGeoName(hintName)`: the fast-index key.
  hintKey          String
  source           CatalogKnowledgeSource
  /// Administrator who asserted it. Null for AUTOMATIC assertions and for
  /// administrative calls made without an authenticated actor (no admin
  /// role model exists yet).
  actorUserId      String?
  /// When this assertion was recorded. Rows backfilled from hint memory
  /// that predates this table carry the migration time.
  createdAt        DateTime               @default(now())
  revokedAt        DateTime?
  revokedByUserId  String?
  revocationReason String?
  geoEntity        GeoEntity              @relation(fields: [geoEntityId], references: [id], onDelete: Restrict)
  actor            User?                  @relation("VerifiedHintAssertionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  revokedBy        User?                  @relation("VerifiedHintAssertionRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([hintKey])
  @@index([geoEntityId, hintKey])
  @@map("geo_entity_verified_hint_assertion")
}

/// One provider-fact observation about a SemanticTarget of a GeoEntity
/// (task 25.7). Provider semantics terminate at the adapter: only the
/// normalized (dimension, key, state) and the stable source-fact identity are
/// stored. A re-observation upserts by `sourceFactId`, superseding only the
/// prior observation of that identity — never last-write-wins across
/// independent sources.
model GeoEntityTargetObservation {
  id           String                 @id @default(uuid())
  geoEntityId  String
  dimension    String
  key          String
  state        TargetObservationState
  sourceFactId String
  geoEntity    GeoEntity              @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([sourceFactId])
  @@index([geoEntityId, dimension, key])
  @@map("geo_entity_target_observation")
}

/// Provider-owned Overture Places runtime index. It is acquisition evidence,
/// never canonical GeoEntity state, and import never creates GeoEntities.
model OverturePlaceIndex {
  id                String                      @id @default(uuid())
  importSessionId   String
  featureId         String
  countryCode       String
  partitionKey      String
  name              String
  normalizedName    String
  alternateNames    String[]                    @default([])
  latitude          Float
  longitude         Float
  address           String?
  upstreamDataset   String?
  upstreamRecordId  String?
  upstreamUpdatedAt DateTime?
  license           String?
  lastSeenAt        DateTime
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  importSession     OverturePlacesImportSession @relation(fields: [importSessionId], references: [id], onDelete: Cascade)

  @@unique([importSessionId, featureId])
  @@index([importSessionId, countryCode, normalizedName])
  @@map("overture_place_index")
}

/// Provider-owned import lifecycle and published snapshot authority. A session
/// becomes visible to runtime lookup only after every expected page succeeds.
model OverturePlacesImportSession {
  id                     String               @id
  countryCode            String
  partitionKey           String
  release                String
  completeness           String
  expectedSourceCoverage String
  sourceUri              String
  licenseNotice          String?
  expectedPageKeys       String[]             @default([])
  completedPageKeys      String[]             @default([])
  failedPartitionKeys    String[]             @default([])
  status                 String
  /// WGS84 extent inside which an OPERATIONAL_AOI import holds every
  /// release record (RW4-ID-CORRESPONDENCE-1). Null for a country import.
  extentWest             Float?
  extentSouth            Float?
  extentEast             Float?
  extentNorth            Float?
  manifest               Json?
  startedAt              DateTime             @default(now())
  finalizedAt            DateTime?
  publishedAt            DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  places                 OverturePlaceIndex[]

  @@index([countryCode, status, publishedAt])
  @@map("overture_places_import_session")
}

model Experience {
  id                       String                      @id @default(uuid())
  canonicalName            String
  description              String?
  durationMinutes          Int?
  price                    Float?
  /// Versioned hash of the ordered constitutive components (GeoEntity id,
  /// participation, traversal bounds) [+ facet key]; null for
  /// source-extracted/legacy Experiences.
  compositionSignature     String?                     @unique
  status                   ExperienceStatus            @default(PENDING)
  qualityScore             Float?
  latitude                 Float?
  longitude                Float?
  openingHours             Json?
  metadata                 Json?
  components               ExperienceComponent[]
  evidence                 ExperienceEvidence[]
  traits                   ExperienceTrait[]
  media                    ExperienceMedia[]
  tourExperiences          TourExperience[]
  mediaStatus              MediaStatus                 @default(PENDING)
  mediaUpdatedAt           DateTime?
  mediaError               String?
  embedding                Unsupported("vector(256)")?
  embeddingProvider        String?
  embeddingModel           String?
  embeddingDimensions      Int?
  embeddingDocumentVersion Int?
  embeddedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([status])
  @@index([latitude, longitude])
  @@index([embeddingProvider, embeddingModel, embeddingDimensions, embeddingDocumentVersion])
  @@map("experience")
}

/// One SOURCE-DECLARED member of an Experience composition, resolved or
/// not. It is not a unique GeoEntity membership row: two source members
/// (for example "Caminito" and "Caminito Street") may resolve to the same
/// GeoEntity and stay two rows. Composite acceptance counts DISTINCT
/// resolved GeoEntities. Read membership only through
/// `experience-source-membership.policy.ts`; completeness (COMPLETE vs
/// PARTIAL) is derived from these rows, never stored.
///
/// DB CHECK `experience_component_resolution_consistent` (migration SQL):
///  - RESOLVED   => geoEntityId set, resolutionReason null;
///  - UNRESOLVED => geoEntityId null, resolutionSource null, and
///                  sourceName, sourcePosition, resolutionReason set.
model ExperienceComponent {
  id                       String                               @id @default(uuid())
  experienceId             String
  /// Null only while the source member is UNRESOLVED.
  geoEntityId              String?
  /// 0-based position of this member in the source-declared composition,
  /// assigned once at persistence and never renumbered. It is the member's
  /// identity inside its Experience. Null only on rows persisted before
  /// source members were recorded (legacy; never fabricated).
  sourcePosition           Int?
  /// The member's component hint name: the source wording the resolver
  /// looked up and that hint memory learns. Null only on legacy rows: never
  /// backfilled from `GeoEntity.name`.
  sourceName               String?
  order                    Int?
  role                     String?
  required                 Boolean                              @default(true)
  resolutionState          ExperienceComponentResolutionState   @default(RESOLVED)
  /// Why an UNRESOLVED member has no GeoEntity. Only PARTIAL-eligible
  /// (missing-knowledge) reasons exist in this enum.
  resolutionReason         ExperienceComponentResolutionReason?
  /// Who linked a RESOLVED member. Null when unknown (legacy rows).
  resolutionSource         CatalogKnowledgeSource?
  /// Typed participation of the member (VISIT / TRAVERSE). Written by the
  /// structured composer; null on legacy rows and read through the
  /// participation migration strategy (venue/waypoint → VISIT, route →
  /// TRAVERSE, area → none yet). Never encodes GeoEntity.kind.
  participation            ExperienceComponentParticipation?
  traversalFromGeoEntityId String?
  traversalToGeoEntityId   String?
  traversalFromLatitude    Float?
  traversalFromLongitude   Float?
  traversalToLatitude      Float?
  traversalToLongitude     Float?
  traversalDirected        Boolean?
  traversalGeometry        Json?
  traversalGeometrySource  String?
  traversalResolvedAt      DateTime?
  experience               Experience                           @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  geoEntity                GeoEntity?                           @relation(fields: [geoEntityId], references: [id], onDelete: Restrict)
  traversalFrom            GeoEntity?                           @relation("TraversalFrom", fields: [traversalFromGeoEntityId], references: [id], onDelete: Restrict)
  traversalTo              GeoEntity?                           @relation("TraversalTo", fields: [traversalToGeoEntityId], references: [id], onDelete: Restrict)

  @@unique([experienceId, sourcePosition])
  @@index([experienceId, resolutionState])
  @@index([geoEntityId])
  @@map("experience_component")
}

model ExperienceEvidence {
  id           String     @id @default(uuid())
  experienceId String
  source       String
  url          String?
  title        String?
  snippet      String?
  discoveredAt DateTime   @default(now())
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("experience_evidence")
}

model ExperienceMedia {
  id           String     @id @default(uuid())
  experienceId String
  provider     String
  url          String
  width        Int?
  height       Int?
  caption      String?
  author       String?
  authorUrl    String?
  license      String?
  licenseUrl   String?
  sourceUrl    String?
  position     Int        @default(0)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([experienceId, url])
  @@index([experienceId, position])
  @@index([provider])
  @@map("experience_media")
}

model TraitDefinition {
  id          String            @id @default(uuid())
  dimension   String
  key         String
  label       String?
  experiences ExperienceTrait[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([dimension, key])
  @@map("trait_definition")
}

model ExperienceTrait {
  experienceId      String
  traitDefinitionId String
  experience        Experience      @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  traitDefinition   TraitDefinition @relation(fields: [traitDefinitionId], references: [id], onDelete: Restrict)

  @@id([experienceId, traitDefinitionId])
  @@index([traitDefinitionId])
  @@map("experience_trait")
}

enum GeoEntityKind {
  PLACE
  AREA
  ROUTE
}

/// Resolution state of one source-declared Experience member.
enum ExperienceComponentResolutionState {
  RESOLVED
  UNRESOLVED
}

/// Persisted reason of an UNRESOLVED source member. Deliberately limited to
/// PARTIAL-eligible (MISSING_KNOWLEDGE) reasons: a blocking deficit never
/// reaches persistence. `RESOLUTION_REVOKED` = an administrator revoked the
/// verified hint the member had been resolved through.
enum ExperienceComponentResolutionReason {
  NO_CANDIDATE_ACQUIRED
  CANDIDATE_UNCONFIRMED
  CANDIDATE_REJECTED
  AMBIGUOUS_CANDIDATES
  RESOLUTION_REVOKED
}

/// Who asserted a piece of catalog knowledge.
enum CatalogKnowledgeSource {
  AUTOMATIC
  ADMIN
}

/// The provider-neutral state of one target observation (task 25.7).
enum TargetObservationState {
  SATISFIES
  DOES_NOT_SATISFY
  INCONCLUSIVE
}

enum ExperienceStatus {
  PENDING
  VERIFIED
  REJECTED
  ARCHIVED
}

/// Destination-independent structured admission outcome (design C14).
enum AdmissionOutcome {
  ADMITTED
  EXCLUDED_CATEGORY
  INSUFFICIENT_ADMISSION_EVIDENCE
}

/// Canonical, provider-neutral admission signal (C6/C7).
enum AdmissionSignal {
  EXPLICIT_VISITOR_CLASSIFICATION
  HISTORIC_CLASSIFICATION
  HERITAGE_DESIGNATION
  VISITABLE_PLACE_CLASS
  ENCYCLOPEDIC_NOTABILITY
  PROVIDER_PROMINENCE
}

/// Canonical admission exclusion class (C6/C7).
enum AdmissionExclusion {
  ADMINISTRATIVE_OR_LOCALITY
  ROAD_OR_ROUTE_AS_PLACE
  INFORMATION_OR_SIGNAGE
  TRANSPORT_SERVICE
  TECHNICAL_INFRASTRUCTURE
  ACCOMMODATION
}

enum GeoEntityRelationType {
  PART_OF
}

enum RelationEvidenceSource {
  PROVIDER_SITE_MEMBERSHIP
  ENCYCLOPEDIC_PART_OF
  DECLARED_CONTAINMENT
}

enum VisitUnitClassification {
  CHILD_REQUIRES_PARENT_VISIT
  CHILD_INDEPENDENTLY_VISITABLE
  AMBIGUOUS_PARENT_RELATIONSHIP
}

enum OpeningHoursStatus {
  KNOWN
  UNKNOWN
}

enum VisitDurationStatus {
  RESOLVED
  CONFLICTING
  INSUFFICIENT_EVIDENCE
}

enum DurationAuthorityClass {
  STRUCTURED_PROVIDER
  OFFICIAL_SITE
  OFFICIAL_TOURISM_OR_INSTITUTIONAL
  REFERENCE_TRAVEL
  USER_GENERATED
  GROUNDED_SYNTHESIS
}

enum ExperienceComponentParticipation {
  VISIT
  TRAVERSE
}

enum IdentityLinkRule {
  FIRST_IDENTITY
  SAME_PROVIDER_ID
  SHARED_ENCYCLOPEDIC_ID
  PROVIDER_STRUCTURAL_RELATION
  PROVIDER_CROSS_LINK
  STRUCTURAL_CORRESPONDENCE
}

enum TourReadinessVerdict {
  READY
  PLANNER_LIMITED
}

/// One structured admission evaluation of a PLACE GeoEntity (0..1). Only
/// destination-independent outcomes are stored; OUTSIDE_DESTINATION and the
/// pre-identity rejections (NO_NAME / NO_COORDINATES / NO_CANONICAL_IDENTITY /
/// DUPLICATE_OF) are never persisted here.
model GeoEntityAdmission {
  geoEntityId   String               @id
  outcome       AdmissionOutcome
  rule          String
  signals       AdmissionSignal[]    @default([])
  exclusions    AdmissionExclusion[] @default([])
  policyVersion String
  evidence      Json
  evaluatedAt   DateTime
  geoEntity     GeoEntity            @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)

  @@index([outcome, policyVersion])
  @@map("geo_entity_admission")
}

/// Structured prominence evidence kind (C17). Prominence is separate from
/// identity, admission, preference relevance and planning readiness.
enum ProminenceEvidenceKind {
  ENCYCLOPEDIC_SITELINK_COUNT
  ENCYCLOPEDIC_LANGUAGE_SITELINK
  HERITAGE_DESIGNATION
  EXPLICIT_VISITOR_CLASSIFICATION
  PROVIDER_PROMINENCE
}

/// One typed structured prominence fact of a GeoEntity (0..N, design C14/C17).
/// An empty set projects as UNKNOWN; it is never a negative value. No
/// universal score is stored.
/// Canonical scope of a heritage designation, normalized by the provider
/// adapter (prominence-v2). UNSPECIFIED: the source does not expose the
/// designating authority's scope.
enum HeritageDesignationScope {
  INTERNATIONAL
  NATIONAL
  SUBNATIONAL
  UNSPECIFIED
}

model GeoEntityProminenceEvidence {
  id               String                    @id @default(uuid())
  geoEntityId      String
  kind             ProminenceEvidenceKind
  sourceProvider   String
  providerIdentity String
  sourceRecordId   String
  fieldPath        String
  numericValue     Int?
  textValue        String?
  languageCode     String?
  authority        String?
  designationLevel String?
  heritageScope    HeritageDesignationScope?
  providerMetric   String?
  comparisonScope  String?
  observedAt       DateTime
  policyVersion    String
  geoEntity        GeoEntity                 @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)

  @@unique([geoEntityId, kind, sourceProvider, sourceRecordId, fieldPath])
  @@index([geoEntityId, kind])
  @@map("geo_entity_prominence_evidence")
}

/// N:M PART_OF relationship between two GeoEntities. `visitUnitClassification`
/// is set only on a direct visit-parent relationship; null for deeper or
/// non-visit relationships kept as knowledge only.
model GeoEntityRelation {
  id                      String                   @id @default(uuid())
  childId                 String
  parentId                String
  type                    GeoEntityRelationType
  evidenceSource          RelationEvidenceSource
  evidence                Json
  visitUnitClassification VisitUnitClassification?
  classificationVersion   String?
  evaluatedAt             DateTime
  child                   GeoEntity                @relation("RelationChild", fields: [childId], references: [id], onDelete: Cascade)
  parent                  GeoEntity                @relation("RelationParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([childId, parentId, type])
  @@index([parentId, type])
  @@index([childId, visitUnitClassification])
  @@map("geo_entity_relation")
}

/// Physical opening hours of a GeoEntity (0..1). Owned by the GeoEntity, not
/// the Experience.
model GeoEntityOpeningHours {
  geoEntityId     String             @id
  status          OpeningHoursStatus
  timezone        String?
  schedule        Json?
  scheduleVersion Int?
  source          String
  sourceRecordRef String?
  sourceRaw       String?
  parserVersion   String?
  retrievedAt     DateTime
  geoEntity       GeoEntity          @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)

  @@index([retrievedAt])
  @@map("geo_entity_opening_hours")
}

/// Visit-duration knowledge of a PLACE GeoEntity (0..1). FALLBACK is never
/// stored — applied at projection by the P-D2-F policy.
model GeoEntityVisitDuration {
  geoEntityId     String                  @id
  status          VisitDurationStatus
  minMinutes      Int?
  typicalMinutes  Int?
  maxMinutes      Int?
  authorityClass  DurationAuthorityClass?
  evidenceQuality String?
  evidence        Json
  resolverVersion String
  resolvedAt      DateTime
  geoEntity       GeoEntity               @relation(fields: [geoEntityId], references: [id], onDelete: Cascade)

  @@index([status, resolvedAt])
  @@map("geo_entity_visit_duration")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String?
  avatarUrl        String?
  provider         AuthProvider
  providerId       String
  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tours                Tour[]
  devices              UserDevice[]
  webPushSubscriptions WebPushSubscription[]

  verifiedHintAssertions        GeoEntityVerifiedHintAssertion[] @relation("VerifiedHintAssertionActor")
  revokedVerifiedHintAssertions GeoEntityVerifiedHintAssertion[] @relation("VerifiedHintAssertionRevoker")

  @@unique([provider, providerId])
  @@map("user")
}

enum AuthProvider {
  GOOGLE
  APPLE
  EMAIL
}

model EmailLoginCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_login_code")
}

model Tour {
  id          String  @id @default(uuid())
  name        String
  description String?

  // Nullable rather than required: tours created before auth existed (and
  // any generated without a logged-in user) have no owner. New tours always
  // get one — enforced by the auth guard on tour creation, not the schema.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Core fields - all optional for flexibility
  price        Float?
  duration     Float? // Duration in hours/days
  maxGroupSize Int?
  startDates   DateTime[] @default([]) // Empty array allowed - PostgreSQL supports arrays

  // Additional flexible fields
  totalDays            Int? // Total days of the tour
  totalDistance        Float? // Total distance in km
  estimatedBudget      Float? // Estimated budget
  recommendedGroupSize Int?

  // Visual content
  coverImage String? // URL to cover image

  // Store prompt/query that generated this tour
  prompt String? // The original prompt used
  query  String? // Search query if applicable

  // Readiness verdict (R4-D4) and planner snapshots (null on legacy tours).
  readinessVerdict    TourReadinessVerdict?
  timezone            String?
  planningContext     Json?
  planningDiagnostics Json?

  // Categories - array of category names (e.g., "walking", "history", "food")
  categories String[] @default([])

  // Flexible metadata
  metadata Json? // Store any additional data from AI

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences TourExperience[]

  @@index([categories]) // Index for category filtering
  @@index([ownerId])
  @@map("tour")
}

// V2 tour snapshot. The shared Experience may be enriched later; this row and
// its component snapshots preserve what the traveller was actually given.
model TourExperience {
  id                 String                    @id @default(uuid())
  tourId             String
  experienceId       String
  dayNumber          Int?
  order              Int                       @default(1)
  startTime          DateTime?
  duration           Float?
  notes              String?
  travelFromPrevious Json?
  endTime            DateTime?
  tour               Tour                      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  experience         Experience                @relation(fields: [experienceId], references: [id], onDelete: Restrict)
  components         TourExperienceComponent[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([tourId, experienceId, dayNumber, order])
  @@index([tourId])
  @@index([experienceId])
  @@map("tour_experience")
}

model TourExperienceComponent {
  id               String                            @id @default(uuid())
  tourExperienceId String
  geoEntityId      String
  order            Int?
  role             String?
  required         Boolean                           @default(true)
  name             String
  latitude         Float?
  longitude        Float?
  geometry         Json?
  participation    ExperienceComponentParticipation?
  plannedStart     DateTime?
  plannedEnd       DateTime?
  planningEvidence Json?
  tourExperience   TourExperience                    @relation(fields: [tourExperienceId], references: [id], onDelete: Cascade)

  @@index([tourExperienceId])
  @@map("tour_experience_component")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CrawlerSearch {
  id          String   @id @default(uuid())
  latitude    Float
  longitude   Float
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([latitude, longitude])
  @@map("crawler_search")
}

model Source {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   @default("external") // "external", "ai", "manual"
  baseUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("source")
}

enum MediaStatus {
  PENDING
  ENRICHED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0)
  maxAttempts   Int          @default(5)
  nextAttemptAt DateTime?
  lastError     String?
  claimedAt     DateTime?
  leaseUntil    DateTime?
  publishedAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseUntil])
  @@index([status, publishedAt])
  @@index([status, failedAt])
  @@map("outbox_event")
}

model NegativeMediaLookup {
  id             String   @id @default(uuid())
  provider       String
  lookupStrategy String
  lookupKey      String
  negativeUntil  DateTime
  createdAt      DateTime @default(now())

  @@unique([provider, lookupStrategy, lookupKey])
  @@index([provider, lookupStrategy, lookupKey, negativeUntil])
  @@map("negative_media_lookup")
}

model UserDevice {
  id            String   @id @default(uuid())
  userId        String
  expoPushToken String   @unique
  platform      String // "ios" | "android" | "web"
  enabled       Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("user_device")
}

model WebPushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@map("web_push_subscription")
}
