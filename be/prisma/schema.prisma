generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  seedCommand     = "npm run seed"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model Activity {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(255)
  description  String?
  difficulty   Difficulty @default(EASY)
  type         String // Changed from enum to string
  duration     Float
  price        Float
  maxGroupSize Int
  // Geolocation fields
  latitude     Float
  longitude    Float
  location     Json // Structured location data
  // Source relationship
  sourceId     String
  source       Source     @relation(fields: [sourceId], references: [id])
  // External identifier from the source system
  externalId   String // Unique identifier within the source

  // the geometry column itself
  coords           Unsupported("geometry(Point, 4326)")?
  // Google Places additional fields
  rating           Float? // Average rating (0-5)
  ratingCount      Int? // Number of reviews
  formattedAddress String? // Formatted address
  phoneNumber      String? // Contact phone number
  website          String? // Official website
  businessStatus   String? // Operational status
  priceLevel       Int? // Price level (0-4)
  photos           Json? // Photo references
  openingHours     Json? // Opening hours
  metadata         Json? // AI-generated metadata

  // Timestamps
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  KnownActivityType     KnownActivityType? @relation(fields: [knownActivityTypeName], references: [name])
  knownActivityTypeName String?
  TourActivity          TourActivity[]
  // Spatial index for faster geographic queries

  sourceRelations ActivityRelationship[] @relation("SourceActivities")
  targetRelations ActivityRelationship[] @relation("TargetActivities")

  @@unique([sourceId, externalId])
  @@map("activity")
}

model KnownActivityType {
  name        String     @id
  description String?
  icon        String?
  category    String?
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("known_activity_types")
}

model Tour {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  price        Float
  duration     Float
  maxGroupSize Int
  startDates   DateTime[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activities TourActivity[]

  @@map("tour")
}

model TourActivity {
  tourId     Int
  activityId Int
  startTime  DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Int       @default(autoincrement()) // Position in tour sequence
  tour       Tour      @relation(fields: [tourId], references: [id])
  activity   Activity  @relation(fields: [activityId], references: [id])

  @@id([tourId, activityId])
  @@index([tourId])
  @@index([activityId])
  @@map("tour_activity")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model CrawlerSearch {
  id          String   @id @default(uuid())
  latitude    Float
  longitude   Float
  deviceToken String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([latitude, longitude])
  @@map("crawler_search")
}

model Source {
  id         String     @id @default(cuid())
  name       String     @unique // "GOOGLE", "TRIPADVISOR", "MANUAL", etc.
  type       String // "API", "CRAWLED", "MANUAL"
  baseUrl    String? // URL base para APIs o sitios crawleados
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("source")
}

enum RelationType {
  SEQUENTIAL // Una actividad es buena para hacer después de otra
  SIMILAR // Actividades similares (para evitar redundancia)
  COMPLEMENTARY // Actividades que se complementan bien
}

model ActivityRelationship {
  sourceActivityId Int          @map("source_activity_id")
  targetActivityId Int          @map("target_activity_id")
  relationType     RelationType @map("relation_type")

  // Scores (0-100)
  compatibilityScore     Int @map("compatibility_score")
  timeCompatibilityScore Int @map("time_compatibility_score")
  distanceScore          Int @map("distance_score")
  varietyScore           Int @map("variety_score")

  // Metadata
  timeGapRecommended Int?    @map("time_gap_recommended")
  reasoning          String? @map("reasoning")
  metadata           Json?   @map("metadata")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  sourceActivity Activity @relation("SourceActivities", fields: [sourceActivityId], references: [id], onDelete: Cascade)
  targetActivity Activity @relation("TargetActivities", fields: [targetActivityId], references: [id], onDelete: Cascade)

  @@id([sourceActivityId, targetActivityId])
  @@index([sourceActivityId])
  @@index([targetActivityId])
  @@index([compatibilityScore, timeCompatibilityScore, distanceScore, varietyScore])
  @@map("activity_relationship")
}
