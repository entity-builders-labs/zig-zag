{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*/test/acceptance/.*\\.(spec|test|pbt-spec|contract-spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^@core/(.*)$": "<rootDir>/src/core/$1",
    "^@shared/(.*)$": "<rootDir>/src/shared/$1",
    "^@activities/(.*)$": "<rootDir>/src/modules/activities/$1",
    "^@tours/(.*)$": "<rootDir>/src/modules/tours/$1",
    "^@integrations/(.*)$": "<rootDir>/src/modules/integrations/$1",
    "^@acceptance/(.*)$": "<rootDir>/test/acceptance/$1"
  },
  "testTimeout": 30000
}
