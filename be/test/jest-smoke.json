{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".*/test/acceptance/smoke/.*\\.smoke-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^@acceptance/(.*)$": "<rootDir>/test/acceptance/$1"
  },
  "testTimeout": 60000
}
