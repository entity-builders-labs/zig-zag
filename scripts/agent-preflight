#!/usr/bin/env bash
set -euo pipefail

ALLOW_DIRTY=0
NO_FETCH=0
CI_MODE=0
for arg in "$@"; do
  case "$arg" in
    --allow-dirty) ALLOW_DIRTY=1 ;;
    --no-fetch) NO_FETCH=1 ;;
    --ci) CI_MODE=1 ;;
    -h|--help) echo 'Usage: bash scripts/agent-preflight [--allow-dirty] [--no-fetch] [--ci]'; exit 0 ;;
    *) echo "Unknown argument: $arg" >&2; exit 2 ;;
  esac
done

write_failures=0; integration_failures=0; warnings=0; integration_blocked=0
pass() { printf 'PASS  %-24s %s\n' "$1" "${2:-}"; }
warn() { printf 'WARN  %-24s %s\n' "$1" "${2:-}"; warnings=$((warnings + 1)); }
fail_write() { printf 'FAIL  %-24s %s\n' "$1" "${2:-}"; write_failures=$((write_failures + 1)); }
block_integration() {
  integration_blocked=1
  if [ "$CI_MODE" -eq 1 ]; then
    printf 'FAIL  %-24s %s\n' "$1" "${2:-}"
    integration_failures=$((integration_failures + 1))
  else
    warn "$1" "${2:-}"
  fi
}

TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$TOP" ] || { echo 'Not inside a Git worktree.' >&2; exit 1; }
# shellcheck source=scripts/agent-track
source "$TOP/scripts/agent-track"

CURRENT_BRANCH="$(git branch --show-current)"
[ "$CI_MODE" -eq 1 ] && [ -n "${GITHUB_HEAD_REF:-}" ] && CURRENT_BRANCH="$GITHUB_HEAD_REF"
if [ -n "$CURRENT_BRANCH" ]; then pass "branch" "$CURRENT_BRANCH"; else fail_write "branch" "detached HEAD; no track can be resolved"; fi
pass "worktree" "$TOP"

ORIGIN_URL="$(git remote get-url origin 2>/dev/null || true)"
case "$ORIGIN_URL" in
  *github.com:entity-builders-labs/zig-zag.git|*github.com/entity-builders-labs/zig-zag.git|*github.com/entity-builders-labs/zig-zag) pass "origin" "$ORIGIN_URL" ;;
  *) fail_write "origin" "expected entity-builders-labs/zig-zag, got: ${ORIGIN_URL:-<missing>}" ;;
esac

if [ "$ALLOW_DIRTY" -eq 0 ] && [ -n "$(git status --porcelain)" ]; then
  fail_write "working tree" "dirty; commit/stash intentional prior work or use --allow-dirty for inspection only"
else
  pass "working tree" "clean or explicitly allowed"
fi

if [ "$NO_FETCH" -eq 0 ]; then
  if git fetch origin --prune >/dev/null 2>&1; then pass "remote refs" "fetched origin --prune"; else fail_write "remote refs" "git fetch origin --prune failed"; fi
else
  warn "remote refs" "fetch skipped by --no-fetch"
fi

if [ -z "$CURRENT_BRANCH" ] || ! resolve_track_by_branch "$TOP" "$CURRENT_BRANCH"; then
  fail_write "track" "expected exactly one ACTIVE progress track for ${CURRENT_BRANCH:-<detached>}"
else
  IFS=$'\t' read -r PROGRESS MARKER <<<"$RESOLVED_TRACK_RECORD"
  TRACK_ID="$(track_field "$MARKER" id)"
  INTEGRATION_BRANCH="$(track_field "$MARKER" integration)"
  BASE_SHA="$(track_field "$MARKER" base)"
  PLAN="$(track_field "$MARKER" plan)"
  pass "track" "$TRACK_ID ($PROGRESS)"

  if [ -z "$INTEGRATION_BRANCH" ] || [ -z "$BASE_SHA" ] || [ -z "$PLAN" ]; then
    fail_write "track contract" "requires integration, base, and plan in $PROGRESS"
  elif [ ! -f "$TOP/$PLAN" ]; then
    fail_write "track plan" "missing $PLAN"
  else
    pass "track contract" "integration=$INTEGRATION_BRANCH plan=$PLAN"
  fi

  if [ "$CI_MODE" -eq 1 ] && [ -n "${GITHUB_BASE_REF:-}" ]; then
    if [ "$GITHUB_BASE_REF" = "$INTEGRATION_BRANCH" ]; then
      pass "PR integration target" "$GITHUB_BASE_REF matches declared integration"
    else
      block_integration "PR integration target" "PR targets $GITHUB_BASE_REF but track declares $INTEGRATION_BRANCH"
    fi
  fi

  if [ -z "$BASE_SHA" ]; then
    fail_write "base snapshot" "track is missing base"
  elif ! git cat-file -e "${BASE_SHA}^{commit}" 2>/dev/null; then
    fail_write "base snapshot" "$BASE_SHA is not available as a commit"
  elif git merge-base --is-ancestor "$BASE_SHA" HEAD; then
    pass "base ancestry" "$BASE_SHA is an ancestor of HEAD"
  else
    fail_write "base ancestry" "HEAD does not contain declared base snapshot $BASE_SHA"
  fi

  INTEGRATION_REF="origin/$INTEGRATION_BRANCH"
  if ! git show-ref --verify --quiet "refs/remotes/$INTEGRATION_REF"; then
    fail_write "integration target ref" "$INTEGRATION_REF does not exist locally after fetch"
  else
    merge_status=0
    merge_output="$(git merge-tree --write-tree HEAD "$INTEGRATION_REF" 2>&1)" || merge_status=$?
    case "$merge_status" in
      0) pass "integration readiness" "non-mutating merge-tree clean vs $INTEGRATION_REF" ;;
      1) block_integration "integration conflict" "merge-tree reports conflicts vs $INTEGRATION_REF"; printf '%s\n' "$merge_output" | sed -n '1,20p' ;;
      *) fail_write "integration readiness" "git merge-tree --write-tree failed with status $merge_status"; printf '%s\n' "$merge_output" | sed -n '1,20p' ;;
    esac
  fi

  if git show-ref --verify --quiet refs/remotes/origin/main; then
    if git merge-base --is-ancestor origin/main HEAD; then
      pass "main relationship" "HEAD contains current origin/main"
    else
      warn "main relationship" "HEAD does not contain current origin/main; do not auto-rebase/merge"
    fi
  fi

  while IFS= read -r OVERLAP_REF; do
    [ -n "$OVERLAP_REF" ] || continue
    PAIR_BASE="$(git merge-base HEAD "$OVERLAP_REF" 2>/dev/null)" || continue
    CURRENT_PAIR_FILES="$(git diff --name-only "$PAIR_BASE"..HEAD | sort -u)"
    OTHER_PAIR_FILES="$(git diff --name-only "$PAIR_BASE".."$OVERLAP_REF" | sort -u)"
    FILE_OVERLAP="$(comm -12 <(printf '%s\n' "$CURRENT_PAIR_FILES" | sed '/^$/d') <(printf '%s\n' "$OTHER_PAIR_FILES" | sed '/^$/d') || true)"
    [ -z "$FILE_OVERLAP" ] || warn "file overlap (remote)" "$(printf '%s' "$FILE_OVERLAP" | tr '\n' ' ')"
  done < <(discover_overlap_refs "$TOP")
fi

printf '\n'
if [ "$write_failures" -gt 0 ]; then
  printf 'WRITE BLOCKED — %d local hard failure(s), %d warning(s).\n' "$write_failures" "$warnings"
  [ "$integration_blocked" -eq 0 ] || printf 'INTEGRATION BLOCKED — resolve reported integration blockers before merging.\n'
  exit 1
fi
if [ "$integration_failures" -gt 0 ]; then
  printf 'STOP INTEGRATION — %d integration blocker(s), %d warning(s).\n' "$integration_failures" "$warnings"
  exit 1
fi
printf 'WRITE AUTHORIZED — 0 hard failures, %d warning(s).\n' "$warnings"
[ "$integration_blocked" -eq 0 ] && printf 'INTEGRATION READY\n' || printf 'INTEGRATION BLOCKED — resolve reported integration blockers before merging.\n'
