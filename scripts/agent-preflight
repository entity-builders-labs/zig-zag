#!/usr/bin/env bash
set -euo pipefail

ALLOW_DIRTY=0
NO_FETCH=0
CI_MODE=0
for arg in "$@"; do
  case "$arg" in
    --allow-dirty) ALLOW_DIRTY=1 ;;
    --no-fetch) NO_FETCH=1 ;;
    --ci) CI_MODE=1 ;;
    -h|--help) echo 'Usage: bash scripts/agent-preflight [--allow-dirty] [--no-fetch] [--ci]'; exit 0 ;;
    *) echo "Unknown argument: $arg" >&2; exit 2 ;;
  esac
done

failures=0; warnings=0
pass() { printf 'PASS  %-24s %s\n' "$1" "${2:-}"; }
warn() { printf 'WARN  %-24s %s\n' "$1" "${2:-}"; warnings=$((warnings + 1)); }
fail() { printf 'FAIL  %-24s %s\n' "$1" "${2:-}"; failures=$((failures + 1)); }

TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$TOP" ] || { echo 'Not inside a Git worktree.' >&2; exit 1; }
# shellcheck source=scripts/agent-track
source "$TOP/scripts/agent-track"

CURRENT_BRANCH="$(git branch --show-current)"
[ "$CI_MODE" -eq 1 ] && [ -n "${GITHUB_HEAD_REF:-}" ] && CURRENT_BRANCH="$GITHUB_HEAD_REF"
if [ -n "$CURRENT_BRANCH" ]; then pass "branch" "$CURRENT_BRANCH"; else fail "branch" "detached HEAD; no track can be resolved"; fi
pass "worktree" "$TOP"

ORIGIN_URL="$(git remote get-url origin 2>/dev/null || true)"
case "$ORIGIN_URL" in
  *github.com:entity-builders-labs/zig-zag.git|*github.com/entity-builders-labs/zig-zag.git|*github.com/entity-builders-labs/zig-zag) pass "origin" "$ORIGIN_URL" ;;
  *) fail "origin" "expected entity-builders-labs/zig-zag, got: ${ORIGIN_URL:-<missing>}" ;;
esac

if [ "$ALLOW_DIRTY" -eq 0 ] && [ -n "$(git status --porcelain)" ]; then
  fail "working tree" "dirty; commit/stash intentional prior work or use --allow-dirty for inspection only"
else
  pass "working tree" "clean or explicitly allowed"
fi

if [ "$NO_FETCH" -eq 0 ]; then
  if git fetch origin --prune >/dev/null 2>&1; then pass "remote refs" "fetched origin --prune"; else fail "remote refs" "git fetch origin --prune failed"; fi
else
  warn "remote refs" "fetch skipped by --no-fetch"
fi

if [ -z "$CURRENT_BRANCH" ] || ! resolve_track_by_branch "$TOP" "$CURRENT_BRANCH"; then
  fail "track" "expected exactly one ACTIVE progress track for ${CURRENT_BRANCH:-<detached>}"
else
  IFS=$'\t' read -r PROGRESS MARKER <<<"$RESOLVED_TRACK_RECORD"
  TRACK_ID="$(track_field "$MARKER" id)"
  INTEGRATION_BRANCH="$(track_field "$MARKER" integration)"
  BASE_SHA="$(track_field "$MARKER" base)"
  PLAN="$(track_field "$MARKER" plan)"
  pass "track" "$TRACK_ID ($PROGRESS)"

  if [ -z "$INTEGRATION_BRANCH" ] || [ -z "$BASE_SHA" ] || [ -z "$PLAN" ]; then
    fail "track contract" "requires integration, base, and plan in $PROGRESS"
  elif [ ! -f "$TOP/$PLAN" ]; then
    fail "track plan" "missing $PLAN"
  else
    pass "track contract" "integration=$INTEGRATION_BRANCH plan=$PLAN"
  fi

  if [ "$CI_MODE" -eq 1 ] && [ -n "${GITHUB_BASE_REF:-}" ]; then
    if [ "$GITHUB_BASE_REF" = "$INTEGRATION_BRANCH" ]; then
      pass "PR integration target" "$GITHUB_BASE_REF matches declared integration"
    else
      fail "PR integration target" "PR targets $GITHUB_BASE_REF but track declares $INTEGRATION_BRANCH"
    fi
  fi

  if [ -z "$BASE_SHA" ]; then
    fail "base snapshot" "track is missing base"
  elif ! git cat-file -e "${BASE_SHA}^{commit}" 2>/dev/null; then
    fail "base snapshot" "$BASE_SHA is not available as a commit"
  elif git merge-base --is-ancestor "$BASE_SHA" HEAD; then
    pass "base ancestry" "$BASE_SHA is an ancestor of HEAD"
  else
    fail "base ancestry" "HEAD does not contain declared base snapshot $BASE_SHA"
  fi

  INTEGRATION_REF="origin/$INTEGRATION_BRANCH"
  if ! git show-ref --verify --quiet "refs/remotes/$INTEGRATION_REF"; then
    fail "integration target ref" "$INTEGRATION_REF does not exist locally after fetch"
  else
    merge_status=0
    merge_output="$(git merge-tree --write-tree HEAD "$INTEGRATION_REF" 2>&1)" || merge_status=$?
    case "$merge_status" in
      0) pass "integration conflict" "non-mutating merge-tree clean vs $INTEGRATION_REF" ;;
      1) fail "integration conflict" "merge-tree reports conflicts vs $INTEGRATION_REF"; printf '%s\n' "$merge_output" | sed -n '1,20p' ;;
      *) fail "integration conflict" "git merge-tree --write-tree failed with status $merge_status"; printf '%s\n' "$merge_output" | sed -n '1,20p' ;;
    esac
  fi

  if git show-ref --verify --quiet refs/remotes/origin/main; then
    if git merge-base --is-ancestor origin/main HEAD; then
      pass "main relationship" "HEAD contains current origin/main"
    else
      warn "main relationship" "HEAD does not contain current origin/main; do not auto-rebase/merge"
    fi
  fi

  changed_files() {
    local ref="$1" integration="$2" merge_base
    git show-ref --verify --quiet "refs/remotes/origin/$integration" || return 0
    merge_base="$(git merge-base "$ref" "origin/$integration")"
    git diff --name-only "$merge_base".."$ref" | sort -u
  }

  CURRENT_FILES="$(changed_files HEAD "$INTEGRATION_BRANCH")"
  while IFS=$'\t' read -r OTHER_BRANCH _OTHER_PROGRESS OTHER_MARKER; do
    OTHER_ID="$(track_field "$OTHER_MARKER" id)"
    OTHER_INTEGRATION="$(track_field "$OTHER_MARKER" integration)"
    [ "$OTHER_BRANCH" != "$CURRENT_BRANCH" ] && [ -n "$OTHER_INTEGRATION" ] || continue
    OTHER_REF="$(track_ref_for_branch "$TOP" "$OTHER_BRANCH" || true)"
    if [ -n "$CURRENT_FILES" ] && [ -n "$OTHER_REF" ]; then
      OTHER_FILES="$(changed_files "$OTHER_REF" "$OTHER_INTEGRATION")"
      FILE_OVERLAP="$(comm -12 <(printf '%s\n' "$CURRENT_FILES" | sed '/^$/d') <(printf '%s\n' "$OTHER_FILES" | sed '/^$/d') || true)"
      [ -z "$FILE_OVERLAP" ] || warn "file overlap: $OTHER_ID" "$(printf '%s' "$FILE_OVERLAP" | tr '\n' ' ')"
    fi
  done < <(discover_active_track_records "$TOP")
fi

printf '\n'
if [ "$failures" -gt 0 ]; then
  printf 'STOP BEFORE WRITE — %d hard failure(s), %d warning(s).\n' "$failures" "$warnings"
  exit 1
fi
printf 'WRITE AUTHORIZED — 0 hard failures, %d warning(s).\n' "$warnings"
