 "wikidata": {
  "Q270446": {
   "qid": "Q270446",
   "label": "Carlos Pellegrini",
   "description": "Lawyer, journalist and former president of Argentina (1846-1906)",
   "aliases": [
    "Carlos Pellegrini",
    "Carlos Enrique José Pellegrini",
    "Carlos Enrique Jose Pellegrini"
   ],
   "sitelinkCount": 31,
   "extract": "Carlos Enrique José Pellegrini Bevans (October 11, 1846 – July 17, 1906) was Vice President of Argentina and became President of Argentina from August 6, 1890 to October 12, 1892, upon Miguel Ángel Juárez Celman's resignation (see Revolución del Parque)."
  },
