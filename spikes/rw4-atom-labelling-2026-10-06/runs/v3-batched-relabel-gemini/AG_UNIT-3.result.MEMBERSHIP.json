      "classification": "NON_ITINERARY",
      "entities": [],
      "reason": "Booking advice."
    },
    {
      "text": "It has an amazing view of Puerto madero.",
      "atomId": "a-080",
      "classification": "NON_ITINERARY",
      "entities": [],
      "reason": "Description of the view from Trade Sky Bar."
    },
    {
