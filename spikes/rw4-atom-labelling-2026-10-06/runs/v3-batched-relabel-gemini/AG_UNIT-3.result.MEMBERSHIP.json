          "sourceEnd": 3553
        },
        {
          "sourceName": "San Telmo",
          "supportSpan": "San Telmo",
          "role": "ROUTE_LEG",
          "sourceStart": 3578,
          "sourceEnd": 3587
        }
      ],
      "reason": "Walk through Defensa Street"
    },
    {
      "text": "Defensa Street is the main street and on Sunday there is a huge street fair that starts from Plaza de Mayo and continues to Plaza Dorrego.",
      "atomId": "a-027",
      "classification": "PASS_BY",
      "entities": [
        {
