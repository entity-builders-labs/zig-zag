      "atomId": "a-001",
      "ordinal": 1,
      "sourceStart": 0,
      "sourceEnd": 24,
      "text": "## The Painted Lane walk",
      "blockKind": "HEADING",
      "blockOrdinal": 1
    },
    {
      "atomId": "a-002",
      "ordinal": 2,
      "sourceStart": 26,
      "sourceEnd": 80,
      "text": "Start at Harbour Square, next to the old fire station.",
      "blockKind": "LINE",
      "blockOrdinal": 3
    },
    {
      "atomId": "a-003",
      "ordinal": 3,
      "sourceStart": 81,
      "sourceEnd": 129,
      "text": "Walk down Mill Street to reach the Painted Lane.",
      "blockKind": "LINE",
      "blockOrdinal": 4
    },
    {
      "atomId": "a-004",
      "ordinal": 4,
      "sourceStart": 130,
      "sourceEnd": 270,
      "text": "The Painted Lane is the reason to come: stroll its whole 150-metre curve slowly, looking at every painted tin house and the murals along it.",
      "blockKind": "LINE",
      "blockOrdinal": 5
    },
    {
      "atomId": "a-005",
      "ordinal": 5,
      "sourceStart": 271,
      "sourceEnd": 334,
      "text": "Halfway along, you will pass the Sailors' Church on your right.",
      "blockKind": "LINE",
      "blockOrdinal": 6
    },
    {
      "atomId": "a-006",
      "ordinal": 6,
      "sourceStart": 335,
      "sourceEnd": 390,
      "text": "At the end of the lane, visit the Riverside Art Museum.",
      "blockKind": "LINE",
      "blockOrdinal": 7
    }
  ],
