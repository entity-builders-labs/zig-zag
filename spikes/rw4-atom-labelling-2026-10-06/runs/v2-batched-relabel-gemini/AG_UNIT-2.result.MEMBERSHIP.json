    {
      "text": "Photography lover, crafter and blogger.",
      "atomId": "a-092",
      "classification": "NON_ITINERARY",
      "entities": [],
      "reason": "Author bio."
    },
    {
      "text": "From Argentina, currently living in Buenos Aires.",
      "atomId": "a-093",
      "classification": "NON_ITINERARY",
      "entities": [],
      "reason": "Author location."
    },
    {
      "text": "Welcome to my blog!",
