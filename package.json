{
  "name": "zig-zag",
  "private": true,
  "workspaces": [
    "be",
    "fe"
  ],
  "scripts": {
    "start:be": "cd be && yarn start:dev",
    "start:fe": "cd fe && FAST_REFRESH=true yarn web",
    "start": "cd fe && FAST_REFRESH=true expo start",
    "web": "cd fe && FAST_REFRESH=true expo start --web",
    "prisma:generate": "cd be && yarn prisma:generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
