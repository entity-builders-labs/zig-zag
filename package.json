{
  "name": "zig-zag",
  "private": true,
  "workspaces": [
    "be",
    "fe"
  ],
  "scripts": {
    "start:be": "cd be && yarn start:dev",
    "start:fe": "cd fe && yarn start",
    "start": "concurrently \"yarn start:be\" \"yarn start:fe\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
