# Multi-stage build for production web app
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./
COPY fe/package.json ./fe/

# Install dependencies
RUN yarn install --frozen-lockfile --production=false

# Install Expo CLI globally
RUN yarn global add @expo/cli

# Copy frontend source files
COPY fe/ ./fe/

# Build the web app
WORKDIR /app/fe

# Set production environment
ENV NODE_ENV=production

# Accept build arguments (passed from Fly.io secrets)
# Fly.io secrets are NOT automatically available during build, so we need to pass them as ARG
ARG EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
ENV EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY

ARG EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL

# Debug: print if variables are available (will be empty in logs for security)
RUN echo "Building with EXPO_PUBLIC_GOOGLE_MAPS_API_KEY set: $([ -n "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY" ] && echo 'YES' || echo 'NO')"
RUN echo "Building with EXPO_PUBLIC_API_URL set: $([ -n "$EXPO_PUBLIC_API_URL" ] && echo 'YES' || echo 'NO')"
RUN npx expo export --platform web

# Production stage with nginx
FROM nginx:alpine

# Copy nginx configuration
COPY fe/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built files from builder
COPY --from=builder /app/fe/dist /usr/share/nginx/html

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

