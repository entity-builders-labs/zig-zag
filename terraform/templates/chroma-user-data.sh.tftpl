#!/bin/bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

if ! swapon --show | grep -q /swapfile; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

cat >/usr/local/bin/start-chroma <<'SCRIPT'
#!/bin/bash
set -euo pipefail

mkdir -p /opt/chroma-data
data_device=''
for attempt in $(seq 1 60); do
  data_device=$(lsblk -rno PATH,TYPE,MOUNTPOINT | awk '$2 == "disk" && $3 == "" && $1 != "/dev/nvme0n1" && $1 != "/dev/xvda" {print $1; exit}')
  [ -n "$data_device" ] && break
  sleep 2
done

if [ -z "$data_device" ]; then
  echo 'Persistent Chroma EBS volume was not attached' >&2
  exit 1
fi

if ! blkid "$data_device" >/dev/null 2>&1; then mkfs.xfs "$data_device"; fi
uuid=$(blkid -s UUID -o value "$data_device")
grep -q "$uuid" /etc/fstab || echo "UUID=$uuid /opt/chroma-data xfs defaults,nofail 0 2" >> /etc/fstab
mountpoint -q /opt/chroma-data || mount /opt/chroma-data

docker pull '${chroma_image}'
docker rm -f chroma >/dev/null 2>&1 || true
docker run -d --name chroma --restart unless-stopped \
  -p 8000:8000 \
  -v /opt/chroma-data:/data \
  -e IS_PERSISTENT=TRUE \
  -e PERSIST_DIRECTORY=/data \
  '${chroma_image}'
SCRIPT
chmod 0755 /usr/local/bin/start-chroma

cat >/etc/systemd/system/zigzag-chroma.service <<'UNIT'
[Unit]
Description=Zig Zag Chroma
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/start-chroma
ExecStop=/usr/bin/docker stop chroma

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now zigzag-chroma.service

# The remote development environment is stopped by default. This runs only
# after the first boot has fully installed and verified the service.
shutdown -h now
