# Node modules (exclude all, will be installed in container)
**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Production builds (exclude, will be built in container)
**/build
**/dist
**/out
**/.next

# IDE files
**/.vscode
**/.idea
**/*.swp
**/*.swo
**/.cursor

# OS files
**/.DS_Store
**/Thumbs.db
**/.DS_Store?

# Git
**/.git
**/.gitignore
**/.gitattributes

# Logs
**/logs
**/*.log

# Runtime data
**/pids
**/*.pid
**/*.seed
**/*.pid.lock

# Coverage directory
**/coverage
**/.nyc_output
**/.jest

# Environment files (sensitive, should not be in image)
**/.env*
**/.env.prod
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.fly

# React Native / Expo specific
**/ios/build
**/ios/Pods
**/ios/**/*.xcworkspace
**/ios/**/*.xcuserdata
**/ios/**/*.xcodeproj
**/android/build
**/android/app/build
**/android/.gradle
**/.expo
**/.expo-shared
**/expo-env.d.ts

# Metro bundler
**/.metro-health-check*
**/.metro

# Temporary folders
**/tmp/
**/temp/
**/storage/

# Docker files
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# Documentation (not needed in production)
**/README.md
**/*.md
**/docs/

# Prisma migrations ARE needed for production deployments
# **/prisma/migrations  # Commented out - migrations are required for production

# MongoDB data (local database, not needed)
**/mongodb_data

# Test files
**/test/
**/*.spec.ts
**/*.spec.js
**/*.test.ts
**/*.test.js
**/jest.config.*
**/jest.setup.*

# TypeScript build info
**/*.tsbuildinfo
**/tsconfig.build.tsbuildinfo

# Fly.io specific
**/fly/

# fe/scripts/ is dev-only tooling for the frontend, not needed in either
# image. Deliberately NOT excluding **/*.sh here — that would also catch
# be/scripts/setup-db.sh, which the backend image needs at container startup
# to run migrations (see be/Dockerfile's start.sh).
fe/scripts/
